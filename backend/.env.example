# Port d'écoute (fourni par Example en production).
PORT=3000

# Base de données — variables discrètes (pas d'encodage d'URL : les mots de passe
# avec %, @ ou : passent tels quels). Dev local : docker-compose `make db-up`,
# MariaDB 10.6 mappée sur le port hôte 33060 pour éviter les conflits.
DB_HOST=localhost
DB_PORT=33060
DB_USER=REDACTED
DB_PASSWORD=REDACTED
DB_NAME=REDACTED

# Alternative legacy (décodage tolérant) : DATABASE_URL=mysql://user:pass@host:3306/REDACTED

# Secret de signature des tokens de session (génère-le : openssl rand -hex 32).
JWT_SECRET=change-moi-32-caracteres-aleatoires-minimum

# Hash bcrypt du mot de passe unique — génère-le : node backend/scripts/hash-password.mjs "<mot de passe>".
AUTH_PASSWORD_HASH=

NODE_ENV=development
