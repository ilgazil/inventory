# Accès de déploiement vers le serveur de production — copiez-moi en .deploy.env puis renseignez.
# NE COMMITTEZ JAMAIS .deploy.env (gitignoré à la racine).
#
# ⚠️ Certains hébergeurs de sites Node.js ne supportent pas la connexion par clé SSH :
# le déploiement demande alors le mot de passe SSH à chaque fois.
PROD_HOST=ssh.example.com
PROD_SSH_USER=user123
PROD_PORT=22
# Dossier du site Node.js côté serveur (relatif au home SSH, ou chemin absolu).
PROD_PATH=sites/inventaire.example.com
# URL publique du site (optionnelle) — affichée dans le récapitulatif du déploiement.
PROD_URL=https://inventaire.example.com

# Mot de passe SSH (si la clé SSH n'est pas supportée).
# Deux options :
#   1. (recommandé) trousseau macOS — pas de secret sur disque :
#      security add-generic-password -s inventory-deploy -a "<PROD_SSH_USER>" -w
#   2. ici, en clair (gitignoré, à tes risques et périls) :
# PROD_SSH_PASSWORD=motdepasse
